<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.ImportPreviewView"
             x:DataType="vm:ImportPreviewViewModel">
    <Border Classes="dialog" Width="560">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}"
                                Margin="0,0,12,0">
                            <PathIcon Data="{StaticResource IconImport}" Width="18" Height="18"
                                      Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="h2" Text="İçe aktar" />
                            <TextBlock Classes="caption" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="Kapat (Esc)">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Summary}" FontWeight="Medium" TextWrapping="Wrap" />

                    <Border Classes="card" Padding="4" MaxHeight="260">
                        <ScrollViewer>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EntryListItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,5">
                                                <Border Classes="avatar" Width="28" Height="28" CornerRadius="7"
                                                        Background="{Binding ColorIndex, Converter={x:Static views:Converters.AvatarBrush}}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="12" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <PathIcon Grid.Column="2" Data="{StaticResource IconClock}" Width="13" Height="13"
                                                          Foreground="{DynamicResource TextTertiary}" IsVisible="{Binding HasTotp}"
                                                          ToolTip.Tip="Doğrulama kodu (TOTP) var" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="caption" Margin="10,4" Text="{Binding MoreText}" IsVisible="{Binding HasMore}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel IsVisible="{Binding HasWarnings}" Spacing="2">
                        <TextBlock Classes="label" Text="Uyarılar" />
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="caption" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- InfoBar (uyarı) -->
                    <Border Background="{DynamicResource DangerBg}" BorderBrush="{DynamicResource CardStroke}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" IsVisible="{Binding PlaintextFile}">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Data="{StaticResource IconAlert}" Width="16" Height="16" Margin="0,1,12,0"
                                      VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                       Text="CSV dosyası tüm parolaları şifresiz içerir. İçe aktardıktan sonra dosyayı silin (Geri Dönüşüm Kutusu'nu da boşaltın)." />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="accent" Content="{Binding ImportText}" Command="{Binding ImportCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
