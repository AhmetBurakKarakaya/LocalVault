<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vault.Desktop.ViewModels"
        x:Class="Vault.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.ico"
        Title="LocalVault"
        Width="1120" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        Background="{DynamicResource WindowBg}">
    <Grid RowDefinitions="Auto,*">
        <!-- Başlık çubuğu: içerik alanına genişletilmiş (Windows 11 tarzı); sağdaki düğmeleri sistem çizer -->
        <Border x:Name="TitleBar" Height="40" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Image Source="/Assets/icon.png" Width="16" Height="16" />
                <TextBlock Text="LocalVault" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentPage}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.15" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>
</Window>
