<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.AutoTypeChooserView"
             x:DataType="vm:AutoTypeChooserViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
    </UserControl.KeyBindings>
    <Border Classes="card" Width="480">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource IconKey}" Width="20" Height="20" Foreground="{DynamicResource AccentText}" />
                <TextBlock Classes="h2" Text="Auto-Type" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
            <Border Classes="field" Padding="10,6">
                <TextBlock Classes="caption" Text="{Binding WindowTitle, StringFormat='Pencere: {0}'}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding WindowTitle}" />
            </Border>

            <TextBox x:Name="Search" PlaceholderText="Kayıt ara" Text="{Binding SearchText}" />
            <ListBox Classes="entries" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Height="220"
                     DoubleTapped="OnDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EntryListItemViewModel">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="avatar" Width="30" Height="30"
                                    Background="{Binding ColorIndex, Converter={x:Static views:Converters.AvatarBrush}}">
                                <TextBlock Text="{Binding Initial}" FontSize="13" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <CheckBox IsChecked="{Binding RememberWindow}" Content="Bu pencereyi seçilen kayda ekle (bir dahaki sefere sormadan yaz)" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Vazgeç" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="Yaz" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
