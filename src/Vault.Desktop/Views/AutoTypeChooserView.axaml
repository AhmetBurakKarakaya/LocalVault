<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.AutoTypeChooserView"
             x:DataType="vm:AutoTypeChooserViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
    </UserControl.KeyBindings>
    <Border Classes="dialog" Width="500">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                            <PathIcon Data="{StaticResource IconKeyboard}" Width="18" Height="18"
                                      Foreground="{DynamicResource AccentText}" />
                        </Border>
                        <TextBlock Classes="h2" Text="Auto-Type" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <Border Classes="chip" HorizontalAlignment="Left" CornerRadius="6" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconOpen}" Width="12" Height="12"
                                      Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Classes="caption" Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="400" ToolTip.Tip="{Binding WindowTitle}" />
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="Search" PlaceholderText="Kayıt ara" Text="{Binding SearchText}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0"
                                      Foreground="{DynamicResource TextTertiary}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Border Classes="card" Padding="0,4">
                        <ListBox Classes="entries" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                 Height="220" DoubleTapped="OnDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryListItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Classes="pill" />
                                        <Border Classes="avatar" Width="30" Height="30"
                                                Background="{Binding ColorIndex, Converter={x:Static views:Converters.AvatarBrush}}">
                                            <TextBlock Text="{Binding Initial}" FontSize="13" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <CheckBox IsChecked="{Binding RememberWindow}" Content="Bu pencereyi seçilen kayda ekle (bir dahaki sefere sormadan yaz)" />
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="accent" Content="Yaz" Command="{Binding ConfirmCommand}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
