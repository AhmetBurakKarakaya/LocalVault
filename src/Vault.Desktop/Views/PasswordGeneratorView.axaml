<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.PasswordGeneratorView"
             x:DataType="vm:PasswordGeneratorViewModel">
    <Border Classes="dialog" Width="520">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="Parola üreteci" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="Kapat (Esc)">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="8">
                        <Border Background="{DynamicResource CodeBg}" CornerRadius="8" Padding="16,14,8,14">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <SelectableTextBlock Classes="mono" FontSize="18" Text="{Binding Generated}"
                                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Yeniden üret"
                                        Command="{Binding RegenerateCommand}">
                                    <PathIcon Data="{StaticResource IconRefresh}" />
                                </Button>
                                <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Kopyala" Command="{Binding CopyCommand}">
                                    <PathIcon Data="{StaticResource IconCopy}" />
                                </Button>
                            </Grid>
                        </Border>
                        <ProgressBar Classes="strength" Value="{Binding StrengthValue}"
                                     Foreground="{Binding StrengthValue, Converter={x:Static views:Converters.StrengthBrush}}" />
                        <TextBlock Classes="caption" Text="{Binding EntropyText}" />
                    </StackPanel>

                    <Border Classes="card" Padding="16,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
                                <TextBlock Text="Uzunluk" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Margin="16,0" Minimum="8" Maximum="64" TickFrequency="1"
                                        IsSnapToTickEnabled="True" Value="{Binding Length}" />
                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Length}" MinWidth="24"
                                           TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                            <Border Classes="divider" />
                            <WrapPanel ItemSpacing="18" LineSpacing="2" Margin="0,4">
                                <CheckBox Content="A-Z" IsChecked="{Binding Uppercase}" />
                                <CheckBox Content="a-z" IsChecked="{Binding Lowercase}" />
                                <CheckBox Content="0-9" IsChecked="{Binding Digits}" />
                                <CheckBox Content="!@#$%" IsChecked="{Binding Symbols}" />
                                <CheckBox Content="Benzer karakterleri çıkar (0/O, 1/l)" IsChecked="{Binding ExcludeAmbiguous}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="accent" Content="Bu parolayı kullan" IsVisible="{Binding CanUse}"
                            Command="{Binding UseCommand}" />
                    <Button Content="Kopyala" Command="{Binding CopyCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
