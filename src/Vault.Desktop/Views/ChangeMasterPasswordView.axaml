<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.ChangeMasterPasswordView"
             x:DataType="vm:ChangeMasterPasswordViewModel">
    <Border Classes="dialog" Width="460">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="h2" Text="Ana parolayı değiştir" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Kasa yeni parolayla ve yeni bir tuzla yeniden şifrelenir. Eski parola artık işe yaramaz." />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="label" Text="Mevcut ana parola" />
                        <TextBox Classes="revealPasswordButton" PasswordChar="•" Text="{Binding CurrentPassword}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Yeni ana parola" Margin="0" />
                        <TextBox Classes="revealPasswordButton" PasswordChar="•" Text="{Binding NewPassword}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar Classes="strength" Value="{Binding StrengthValue}" VerticalAlignment="Center"
                                         Foreground="{Binding StrengthValue, Converter={x:Static views:Converters.StrengthBrush}}" />
                            <TextBlock Grid.Column="1" Classes="caption" Margin="10,0,0,0" MinWidth="70"
                                       Text="{Binding StrengthText}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Classes="label" Text="Yeni ana parola (tekrar)" />
                        <TextBox Classes="revealPasswordButton" PasswordChar="•" Text="{Binding ConfirmPassword}" />
                    </StackPanel>

                    <TextBlock Classes="error" Text="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="accent" Content="Değiştir" Command="{Binding ChangeCommand}" IsDefault="True"
                            HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
