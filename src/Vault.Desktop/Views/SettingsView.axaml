<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             x:Class="Vault.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Border Classes="dialog" Width="600">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Classes="h2" Text="Ayarlar" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" Command="{Binding CancelCommand}" ToolTip.Tip="Kapat (Esc)">
                            <PathIcon Data="{StaticResource IconClose}" />
                        </Button>
                    </Grid>

                    <!-- Güvenlik -->
                    <TextBlock Classes="group" Text="Güvenlik" />
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Bilgisayar boşta kalınca kilitle" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.AutoLockOptions}" SelectedItem="{Binding AutoLock}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Kopyalanan parolayı panodan sil" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ClipboardOptions}"
                                      SelectedItem="{Binding ClipboardClear}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Windows oturumu kilitlenince kasayı kilitle" />
                            <ToggleSwitch IsChecked="{Binding LockOnSessionLock}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Pencere simge durumuna küçültülünce kilitle" />
                            <ToggleSwitch IsChecked="{Binding LockOnMinimize}" />
                        </Grid>
                    </Border>

                    <!-- Uygulama -->
                    <TextBlock Classes="group" Text="Uygulama" />
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Tema" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ThemeOptions}" SelectedItem="{Binding Theme}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Kapat düğmesi uygulamayı tepsiye gizlesin" />
                            <ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Açılışta pencereyi gösterme (yalnızca tepsi)" />
                            <ToggleSwitch IsChecked="{Binding StartMinimized}" />
                        </Grid>
                    </Border>

                    <!-- Auto-Type -->
                    <TextBlock Classes="group" Text="Auto-Type" IsVisible="{Binding AutoTypeSupported}" />
                    <Border Classes="setting" IsVisible="{Binding AutoTypeSupported}">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Kısayolla etkin pencereye kullanıcı adı ve parola yaz" TextWrapping="Wrap" />
                                <TextBlock Classes="caption" Text="{Binding AutoTypeStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding AutoTypeEnabled}" />
                        </Grid>
                    </Border>
                    <Border Classes="setting" IsVisible="{Binding AutoTypeSupported}">
                        <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="40">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Kısayol" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Değiştirmek için kutuya tıklayıp yeni tuş birleşimine basın." />
                                <TextBlock x:Name="HotkeyMessageText" Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{Binding HotkeyMessage}" IsVisible="{Binding HasHotkeyMessage}"
                                           Classes.error="{Binding HotkeyMessageIsError}" />
                            </StackPanel>
                            <Button x:Name="HotkeyBox" Grid.Column="1" Classes="hotkey" MinWidth="150"
                                    HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                    Classes.recording="{Binding IsRecordingHotkey}"
                                    AutomationProperties.Name="Auto-Type kısayolu"
                                    Click="OnHotkeyBoxClick" LostFocus="OnHotkeyBoxLostFocus">
                                <TextBlock Classes="mono" Text="{Binding HotkeyDisplay}" />
                            </Button>
                            <Button Grid.Column="2" Classes="icon" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip.Tip="Varsayılana dön (Ctrl+Alt+A)" IsVisible="{Binding !IsDefaultHotkey}"
                                    Command="{Binding ResetHotkeyCommand}">
                                <PathIcon Data="{StaticResource IconRefresh}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tarayıcı -->
                    <TextBlock Classes="group" Text="Tarayıcı" />
                    <Border Classes="setting">
                        <Grid Classes="setting" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Tarayıcı eklentisinin bağlanmasına izin ver" TextWrapping="Wrap" />
                                <TextBlock Classes="caption" Text="{Binding BrowserStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding BrowserIntegrationEnabled}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Associations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BrowserAssociationItem">
                                <Border Classes="setting">
                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="36">
                                        <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16" Margin="0,0,14,0"
                                                  Foreground="{DynamicResource TextSecondary}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Classes="caption" Text="{Binding CreatedText}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Kaldır" Command="{Binding RemoveCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="caption" Text="Henüz bağlı tarayıcı yok." Margin="4,2,0,0"
                               IsVisible="{Binding !HasAssociations}" />

                    <!-- Dosyalar -->
                    <TextBlock Classes="group" Text="Dosyalar" />
                    <Border Classes="setting">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <TextBlock Classes="caption" Text="Kasa" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Classes="caption mono" Text="{Binding VaultPath}"
                                       TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding VaultPath}" />
                            <TextBlock Grid.Row="1" Classes="caption" Text="Ayarlar" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption mono" Text="{Binding SettingsPath}"
                                       TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding SettingsPath}" />
                        </Grid>
                    </Border>

                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" Margin="0,8,0,0"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="accent" Content="Kaydet" Command="{Binding SaveCommand}" />
                    <Button Content="Vazgeç" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <UserControl.Styles>
        <Style Selector="Button.hotkey.recording">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.hotkey.recording /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock#HotkeyMessageText.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,14,0,6" />
        </Style>
        <Style Selector="Border.setting">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
    </UserControl.Styles>
</UserControl>
