<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             x:Class="Vault.Desktop.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel">
    <Border Classes="card" Width="440">
        <StackPanel Spacing="14">
            <TextBlock Classes="h2" Text="{Binding Title}" />
            <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button Content="Vazgeç" Command="{Binding CancelCommand}" />
                <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                        Classes.danger="{Binding IsDestructive}" Classes.accent="{Binding !IsDestructive}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
