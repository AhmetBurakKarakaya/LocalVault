<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             x:Class="Vault.Desktop.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel">
    <Border Classes="dialog" Width="440">
        <StackPanel>
            <Border Classes="dialog-body">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Classes="dialog-footer">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" HorizontalAlignment="Stretch"
                            Classes.danger="{Binding IsDestructive}" Classes.accent="{Binding !IsDestructive}" />
                    <Button Grid.Column="1" Content="Vazgeç" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
