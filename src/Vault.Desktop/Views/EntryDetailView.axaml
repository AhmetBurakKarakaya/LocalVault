<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.Views.EntryDetailView"
             x:DataType="vm:EntryDetailViewModel">
    <ScrollViewer>
        <StackPanel Margin="40,32,40,40" MaxWidth="760" Spacing="18">
            <!-- Başlık -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="avatar" Width="52" Height="52" CornerRadius="14"
                        Background="{Binding ColorIndex, Converter={x:Static views:Converters.AvatarBrush}}">
                    <TextBlock Text="{Binding Initial}" FontSize="22" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding UpdatedText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="tool" ToolTip.Tip="Düzenle (Ctrl+E)" Command="{Binding EditCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconPencil}" />
                            <TextBlock Text="Düzenle" />
                        </StackPanel>
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Sil (Delete)" Command="{Binding DeleteCommand}">
                        <PathIcon Data="{StaticResource IconDelete}" Foreground="{DynamicResource DangerBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Kullanıcı adı -->
            <StackPanel IsVisible="{Binding HasUsername}">
                <TextBlock Classes="label" Text="Kullanıcı adı" />
                <Border Classes="field">
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock Text="{Binding Username}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Kopyala (Ctrl+B)"
                                Command="{Binding CopyUsernameCommand}">
                            <PathIcon Data="{StaticResource IconCopy}" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Parola -->
            <StackPanel IsVisible="{Binding HasPassword}">
                <TextBlock Classes="label" Text="Parola" />
                <Border Classes="field">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <SelectableTextBlock Classes="mono" Text="{Binding DisplayPassword}" VerticalAlignment="Center"
                                             TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Göster / gizle"
                                Command="{Binding TogglePasswordVisibilityCommand}">
                            <PathIcon Data="{Binding IsPasswordVisible, Converter={x:Static views:Converters.EyeIcon}}" />
                        </Button>
                        <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Kopyala (Ctrl+C)"
                                Command="{Binding CopyPasswordCommand}">
                            <PathIcon Data="{StaticResource IconCopy}" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- TOTP -->
            <StackPanel IsVisible="{Binding HasTotp}">
                <TextBlock Classes="label" Text="Doğrulama kodu (TOTP)" />
                <Border Classes="field" Background="{DynamicResource CodeBg}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock x:Name="TotpCode" Classes="mono" Text="{Binding TotpCode}" FontSize="26"
                                   FontWeight="SemiBold"
                                   Classes.expiring="{Binding IsTotpExpiring}" />
                        <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Kopyala (Ctrl+T)"
                                Command="{Binding CopyTotpCommand}">
                            <PathIcon Data="{StaticResource IconCopy}" />
                        </Button>
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,8,0,2">
                            <ProgressBar Value="{Binding TotpProgress}" Maximum="100" Height="4" MinHeight="4"
                                         VerticalAlignment="Center" CornerRadius="2" />
                            <TextBlock Grid.Column="1" Classes="caption" Margin="10,0,0,0" MinWidth="34"
                                       TextAlignment="Right" Text="{Binding TotpRemaining, StringFormat='{}{0} sn'}" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Classes="error" Margin="0,4,0,0" Text="{Binding TotpError}"
                           IsVisible="{Binding TotpError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- Web siteleri -->
            <StackPanel IsVisible="{Binding HasUrls}">
                <TextBlock Classes="label" Text="Web siteleri" />
                <Border Classes="field" Padding="14,4">
                    <ItemsControl ItemsSource="{Binding UrlItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:UrlItemViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <SelectableTextBlock Text="{Binding Url}" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource AccentText}" />
                                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Tarayıcıda aç"
                                            Command="{Binding OpenCommand}">
                                        <PathIcon Data="{StaticResource IconOpen}" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Kopyala"
                                            Command="{Binding CopyCommand}">
                                        <PathIcon Data="{StaticResource IconCopy}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock Classes="caption" Margin="0,4,0,0"
                           Text="{Binding MatchModeLabel, StringFormat='Eşleşme: {0}'}" />
            </StackPanel>

            <!-- Notlar -->
            <StackPanel IsVisible="{Binding HasNotes}">
                <TextBlock Classes="label" Text="Notlar" />
                <Border Classes="field">
                    <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasAutoType}">
                <TextBlock Classes="label" Text="Auto-Type (Ctrl+Alt+A)" />
                <Border Classes="field">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding AutoTypeText}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption mono" Text="{Binding AutoTypeSequence}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasTags}">
                <TextBlock Classes="label" Text="Etiketler" />
                <TextBlock Classes="secondary" Text="{Binding Tags}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <!-- Yerel Foreground stil ayarını ezeceğinden renkler burada tanımlı -->
        <Style Selector="TextBlock#TotpCode">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </Style>
        <Style Selector="TextBlock#TotpCode.expiring">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
