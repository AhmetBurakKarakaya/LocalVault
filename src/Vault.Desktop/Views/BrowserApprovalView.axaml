<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             x:Class="Vault.Desktop.Views.BrowserApprovalView"
             x:DataType="vm:BrowserApprovalViewModel">
    <Border Classes="card" Width="460">
        <StackPanel Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Data="{StaticResource IconShieldKey}" Width="22" Height="22"
                          Foreground="{DynamicResource AccentText}" />
                <TextBlock Classes="h2" Text="Tarayıcı bağlantı isteği" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="secondary" Text="{Binding Message}" TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="Doğrulama kodu" />
                <Border Classes="field" Background="{DynamicResource CodeBg}" HorizontalAlignment="Left" Padding="16,10">
                    <TextBlock Classes="mono" Text="{Binding VerificationCode}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" LetterSpacing="2" />
                </Border>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Bu kod, eklentinin ayarlar sayfasında gösterilen kodla aynı olmalı. Farklıysa veya bu isteği siz başlatmadıysanız reddedin." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Reddet" Command="{Binding DenyCommand}" />
                <Button Classes="accent" Content="İzin ver" Command="{Binding ApproveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
