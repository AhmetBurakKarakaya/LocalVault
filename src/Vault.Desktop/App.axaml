        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Uygulamanın çizdiği başlık çubuğu: başlığı kendimiz gösteriyoruz; Windows'ta tam ekran düğmesi alışılmış değil -->
        <!-- IsVisible şablonda bağlı olduğundan stil onu ezemez; Opacity kullanılır -->
        <Style Selector="Panel#PART_TitleTextPanel">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector=":is(Control)#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- ================= Tipografi (Windows 11 tip ölçeği) ================= -->
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <!-- :is() → SelectableTextBlock gibi türetilmiş tipler de eşleşir -->
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>

        <!-- ================= Yüzeyler ================= -->
        <!-- İçerik katmanı (Mica üzerindeki açık/koyu yüzey) -->
        <Style Selector="Border.layer">
            <Setter Property="Background" Value="{DynamicResource LayerBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LayerStroke}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="CornerRadius" Value="8,0,0,0" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!-- Ortalanmış giriş kartı (kilit / kasa oluşturma) -->
        <Style Selector="Border.hero">
            <Setter Property="Background" Value="{DynamicResource CardSolidBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="36,32" />
            <Setter Property="BoxShadow" Value="0 16 48 0 #24000000" />
        </Style>
        <!-- ContentDialog benzeri iletişim penceresi -->
        <Style Selector="Border.dialog">
            <Setter Property="Background" Value="{DynamicResource CardSolidBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 32 64 0 #3D000000" />
        </Style>
        <Style Selector="Border.dialog-body">
            <Setter Property="Padding" Value="24,22,24,20" />
        </Style>
        <Style Selector="Border.dialog-footer">
            <Setter Property="Background" Value="{DynamicResource DialogFooterBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="24,18" />
        </Style>
        <Style Selector="Border.dialog-footer Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- Eski "field" yüzeyi (ayarlar, üreteç vb.) -->
        <Style Selector="Border.field">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
        </Style>

        <!-- Avatar (baş harf) -->
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.avatar > TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ================= Düğmeler ================= -->
        <Style Selector="Button, ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Sade düğme: kenarlıksız, üzerine gelince hafif dolgu (komut çubukları için) -->
        <Style Selector="Button.subtle, Button.icon, Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillPressed}" />
        </Style>
        <Style Selector="Button.icon">
            <!-- Yalnızca simgeden oluşan düğmeler ekran okuyuculara ipucu metniyle tanıtılır -->
            <Setter Property="AutomationProperties.Name" Value="{Binding $self.(ToolTip.Tip)}" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
        </Style>
        <Style Selector="ToggleButton.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderBrush" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B0261A" />
            <Setter Property="BorderBrush" Value="#B0261A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        </Style>

        <!-- Satır içi işlem düğmeleri yalnızca satırın üzerine gelince (veya klavye odağında) görünür -->
        <Style Selector="Grid.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Grid.row Button.reveal">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.row:pointerover Button.reveal, Grid.row:focus-within Button.reveal, Grid.row Button.reveal:focus">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- ================= Gezinme ve liste ================= -->
        <Style Selector="ListBox.nav, ListBox.entries">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!-- Seçili öğenin solundaki vurgu çubuğu (Windows 11 gezinme göstergesi) -->
        <Style Selector="Border.pill">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-10,0,0,0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.pill">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Parola gücü çubuğu -->
        <Style Selector="ProgressBar.strength">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="5" />
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <!-- Ayar satırları (Windows Ayarlar uygulaması gibi) -->
        <Style Selector="Grid.setting">
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="Grid.setting > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style Selector="Grid.setting > ToggleSwitch">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Grid.setting > ComboBox">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Width" Value="170" />
        </Style>
    </Application.Styles>
</Application>
