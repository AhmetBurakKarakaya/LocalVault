<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vault.Desktop.ViewModels"
             xmlns:views="using:Vault.Desktop.Views"
             x:Class="Vault.Desktop.App"
             Name="LocalVault"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="vm:UnlockViewModel"><views:UnlockView /></DataTemplate>
        <DataTemplate DataType="vm:CreateVaultViewModel"><views:CreateVaultView /></DataTemplate>
        <DataTemplate DataType="vm:VaultViewModel"><views:VaultView /></DataTemplate>
        <DataTemplate DataType="vm:EntryDetailViewModel"><views:EntryDetailView /></DataTemplate>
        <DataTemplate DataType="vm:EntryEditorViewModel"><views:EntryEditorView /></DataTemplate>
        <DataTemplate DataType="vm:PasswordGeneratorViewModel"><views:PasswordGeneratorView /></DataTemplate>
        <DataTemplate DataType="vm:ConfirmViewModel"><views:ConfirmView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:ChangeMasterPasswordViewModel"><views:ChangeMasterPasswordView /></DataTemplate>
        <DataTemplate DataType="vm:BrowserApprovalViewModel"><views:BrowserApprovalView /></DataTemplate>
        <DataTemplate DataType="vm:AutoTypeChooserViewModel"><views:AutoTypeChooserView /></DataTemplate>
        <DataTemplate DataType="vm:ImportPreviewViewModel"><views:ImportPreviewView /></DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Katmanlar: Mica üzerinde yarı saydam; Mica yoksa düz WindowBg üzerinde aynı tonu verir -->
                    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="LayerBg" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="LayerStroke" Color="#0F000000" />
                    <SolidColorBrush x:Key="CardBg" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="CardSolidBg" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStroke" Color="#0F000000" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="SubtleFill" Color="#09000000" />
                    <SolidColorBrush x:Key="SubtleFillPressed" Color="#06000000" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#E4000000" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#9E000000" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#72000000" />
                    <SolidColorBrush x:Key="DialogFooterBg" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="SmokeBg" Color="#4D000000" />
                    <SolidColorBrush x:Key="AccentText" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#1A2563EB" />
                    <SolidColorBrush x:Key="CodeBg" Color="#142563EB" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DangerBg" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="SuccessBg" Color="#DFF6DD" />
                    <SolidColorBrush x:Key="InfoBarBg" Color="#F7FFFFFF" />
                    <!-- Eski anahtarlar -->
                    <SolidColorBrush x:Key="SidebarBg" Color="Transparent" />
                    <SolidColorBrush x:Key="FieldBg" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="SubtleBorder" Color="#0F000000" />
                    <SolidColorBrush x:Key="HoverBg" Color="#09000000" />
                    <SolidColorBrush x:Key="SelectedBg" Color="#0F000000" />
                    <SolidColorBrush x:Key="OverlayBg" Color="#4D000000" />
                    <!-- Fluent kontrol kaynakları (Fluent 2 düğme ve metin kutusu) -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DF9F9F9" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#18000000" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#0F000000" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2E000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBg" Color="#202020" />
                    <SolidColorBrush x:Key="LayerBg" Color="#4C3A3A3A" />
                    <SolidColorBrush x:Key="LayerStroke" Color="#19000000" />
                    <SolidColorBrush x:Key="CardBg" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="CardSolidBg" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="CardStroke" Color="#19000000" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="SubtleFill" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SubtleFillPressed" Color="#0AFFFFFF" />
                    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="DialogFooterBg" Color="#202020" />
                    <SolidColorBrush x:Key="SmokeBg" Color="#4D000000" />
                    <SolidColorBrush x:Key="AccentText" Color="#93C5FD" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#263B82F6" />
                    <SolidColorBrush x:Key="CodeBg" Color="#1F3B82F6" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="DangerBg" Color="#442726" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="SuccessBg" Color="#393D1B" />
                    <SolidColorBrush x:Key="InfoBarBg" Color="#F02C2C2C" />
                    <SolidColorBrush x:Key="SidebarBg" Color="Transparent" />
                    <SolidColorBrush x:Key="FieldBg" Color="#0DFFFFFF" />
                    <SolidColorBrush x:Key="SubtleBorder" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="HoverBg" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="SelectedBg" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="OverlayBg" Color="#4D000000" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#30FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Vurgu rengi: simgedeki mavi -->
            <Color x:Key="SystemAccentColor">#2563EB</Color>
            <Color x:Key="SystemAccentColorDark1">#1D4ED8</Color>
            <Color x:Key="SystemAccentColorDark2">#1E40AF</Color>
            <Color x:Key="SystemAccentColorDark3">#1E3A8A</Color>
            <Color x:Key="SystemAccentColorLight1">#3B82F6</Color>
            <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
            <Color x:Key="SystemAccentColorLight3">#93C5FD</Color>

            <!-- Fluent 2 köşe yarıçapları -->
            <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
            <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
